# Build-time settings for the web app (Vite). No secrets belong here: every
# VITE_ value ends up in the browser bundle.

# The API. Empty = same origin (the dev proxy below, or the API behind the
# same Front Door as the app).
VITE_API_BASE_URL=

# The Blob Storage endpoint frames are uploaded to and read from, for the
# Content-Security-Policy. Required for builds. Azurite locally:
VITE_BLOB_ORIGIN=http://127.0.0.1:10000

# Where `pnpm dev` proxies /v1 (the platform API).
VITE_API_PROXY_TARGET=http://localhost:3000
